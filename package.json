{
	"name": "soulobby",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "tsc --noEmit",
		"format": "biome check --write",
		"lint": "biome check",
		"dev": "tsx --env-file=.env.development source/index.ts",
		"start": "node --import ./distribution/sentry.js distribution/index.js",
		"deploy-commands-dev": "tsx --env-file=.env.development source/utility/deploy-commands.ts",
		"deploy-commands": "NODE_ENV=production tsx --env-file=.env.production source/utility/deploy-commands.ts",
		"update": "pnpm update --interactive --latest",
		"knip": "knip"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.806.0",
		"@sentry/node": "^10.22.0",
		"croner": "^9.0.0",
		"diff": "^8.0.2",
		"discord.js": "dev",
		"hasha": "^6.0.0",
		"knex": "^3.1.0",
		"pg": "^8.15.6",
		"runescape": "^0.11.1",
		"sharp": "^0.34.1",
		"ts-mixer": "^6.0.4",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@types/node": "^24",
		"knip": "^5.67.1",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	},
	"packageManager": "pnpm@10.20.0"
}
