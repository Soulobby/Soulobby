{
	"name": "soulobby",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"dev": "tsx --env-file=.env.development source/index.ts | pino-pretty",
		"start": "node --import ./distribution/sentry.js distribution/index.js",
		"deploy-commands-dev": "tsx --env-file=.env.development source/utility/deploy-commands.ts | pino-pretty",
		"deploy-commands": "NODE_ENV=production tsx --env-file=.env.production source/utility/deploy-commands.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.931.0",
		"@discordjs/builders": "dev",
		"@discordjs/formatters": "dev",
		"@sentry/node": "^10.25.0",
		"croner": "^9.1.0",
		"diff": "^8.0.2",
		"discord.js": "dev",
		"hasha": "^7.0.0",
		"knex": "^3.1.0",
		"pg": "^8.16.3",
		"pino": "^10.1.0",
		"runescape": "^0.11.5",
		"sharp": "^0.35.3",
		"ts-mixer": "^6.0.4",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@types/node": "^24.10.1",
		"knip": "^5.69.1",
		"pino-pretty": "^13.1.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
