{
	"name": "@soulobby/notifications",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "tsc --noEmit",
		"format": "biome check --write",
		"lint": "biome check",
		"dev": "tsx --env-file=.env.development source/index.ts | pino-pretty",
		"start": "node --import ./distribution/sentry.js distribution/index.js"
	},
	"dependencies": {
		"@discordjs/core": "dev",
		"@discordjs/rest": "dev",
		"@sentry/node": "^10.31.0",
		"croner": "^9.1.0",
		"pino": "^10.1.0",
		"runescape": "^0.11.5",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@types/node": "^24.10.1",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.21.0",
		"typescript": "5.9.3"
	}
}
